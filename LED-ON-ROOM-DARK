// resistor for LED is 220 ohm.
// Daisy chaines two 4.7k ohm resistors for the LDR.
// Button is pressed to illuminate the LDR and simulate a lit room, led should turn off when button isnt pressed. filament bulb turns on when button pressed


const int ldrPin = A0;
const int ledPin = 9;

const int darkThreshold = 500;  // change this after testing

void setup() {
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  int lightValue = analogRead(ldrPin);

  Serial.print("LDR: ");
  Serial.println(lightValue);

  if (lightValue < darkThreshold) {
    digitalWrite(ledPin, HIGH);  // dark = LED on
  } else {
    digitalWrite(ledPin, LOW);   // bright = LED off
  }

  delay(100);
}
