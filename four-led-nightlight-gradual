const int ledPins[] = {3, 5, 6, 9};
const int numLeds = 4;

const int fadeDelay = 15;   // smaller = faster fade
const int holdTime = 500;   // pause while one LED is fully on

void setup() {
  for (int i = 0; i < numLeds; i++) {
    pinMode(ledPins[i], OUTPUT);
    analogWrite(ledPins[i], 0);
  }
}

void loop() {
  for (int current = 0; current < numLeds; current++) {
    int next = (current + 1) % numLeds;

    // Turn current LED fully on
    analogWrite(ledPins[current], 255);
    delay(holdTime);

    // Fade current LED out while next LED fades in
    for (int brightness = 0; brightness <= 255; brightness++) {
      analogWrite(ledPins[current], 255 - brightness);
      analogWrite(ledPins[next], brightness);
      delay(fadeDelay);
    }

    // Make sure all other LEDs are off
    for (int i = 0; i < numLeds; i++) {
      if (i != next) {
        analogWrite(ledPins[i], 0);
      }
    }
  }
}
